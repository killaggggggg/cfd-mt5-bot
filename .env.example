# MT5 Connection (optional if terminal is already logged in)
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=

# Target Symbol & Execution
BOT_SYMBOL=XAUUSD
BOT_TIMEFRAME=M15
BOT_MAGIC_NUMBER=202611
BOT_DRY_RUN=true
BOT_POLL_SECONDS=5

# Lot Sizing Mode: fixed | dynamic_risk | dynamic_equity_step
LOT_MODE=dynamic_risk
FIXED_LOT=0.01
RISK_PERCENT=1.0
USE_EQUITY_FOR_RISK=true
EQUITY_STEP_AMOUNT=1000.0
EQUITY_STEP_LOT=0.01
MAX_LOT_CAP=1.00
MIN_SL_POINTS=150

# Broker Leverage & Margin Guard
MAX_EFFECTIVE_ACCOUNT_LEVERAGE=20.0
MAX_EFFECTIVE_SYMBOL_LEVERAGE=15.0
MAX_MARGIN_USAGE_PCT=25.0
MIN_MARGIN_LEVEL_PCT=500.0
SCALE_DOWN_LOT_FOR_LEVERAGE=true

# Preventive Cost Guards (Spread, Swap, Commission, Slippage)
# MAX_SPREAD_POINTS=0.0 disables fixed point limit and uses Spread/TP & Spread/ATR instead
MAX_SPREAD_POINTS=0.0
MAX_SPREAD_TO_TP_RATIO=0.20
MAX_SPREAD_TO_ATR_RATIO=0.35
COMMISSION_PER_LOT_ROUNDTRIP=7.0
AUTO_DETECT_COMMISSION=true
ESTIMATED_SLIPPAGE_POINTS=5.0
MIN_NET_RR=1.20
MAX_SWAP_TO_TP_RATIO=0.15
SWAP_ROLLOVER_HOUR_SERVER=0
ROLLOVER_BLACKOUT_MINUTES_BEFORE=20
ROLLOVER_BLACKOUT_MINUTES_AFTER=15
ENFORCE_ROLLOVER_BLACKOUT_FOR_INTRADAY=true

# Safety & Circuit Breakers
MAX_DAILY_LOSS_PCT=3.0
MAX_OPEN_POSITIONS_SYMBOL=1
MAX_OPEN_POSITIONS_TOTAL=3
MAX_QUOTE_AGE_SECONDS=30

# Economic News & Bank Holiday Guard
ENABLE_NEWS_GUARD=true
ENABLE_HOLIDAY_GUARD=true
HOLIDAY_POLICY=block
NEWS_BLOCK_MINUTES_BEFORE=30
NEWS_BLOCK_MINUTES_AFTER=30
BLOCK_MEDIUM_IMPACT_NEWS=false
NEWS_WARN_HOURS=12
FAIL_CLOSED_ON_CALENDAR_ERROR=false
CUSTOM_EVENTS_PATH=config/custom_events.json

# Active Trade Management (True Break-Even & ATR Trailing Stop)
ENABLE_AUTO_BREAKEVEN=true
BREAKEVEN_TRIGGER_R=1.0
BREAKEVEN_LOCK_POINTS=5
ENABLE_TRAILING_STOP=true
TRAILING_ATR_MULT=1.5
TRAILING_STEP_POINTS=10
